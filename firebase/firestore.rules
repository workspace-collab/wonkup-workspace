rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.status == 'active';
    }

    function isSuperadmin() {
      return hasActiveProfile()
        && get(userPath(request.auth.uid)).data.role == 'superadmin';
    }

    function workspaceMemberPath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid);
    }

    function isWorkspaceMember(workspaceId) {
      return isSuperadmin() || (
        hasActiveProfile()
        && exists(workspaceMemberPath(workspaceId))
        && get(workspaceMemberPath(workspaceId)).data.status == 'active'
      );
    }

    function workspaceRole(workspaceId) {
      return isSuperadmin()
        ? 'superadmin'
        : get(workspaceMemberPath(workspaceId)).data.role;
    }

    function isWorkspaceAdmin(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && workspaceRole(workspaceId) in ['superadmin', 'workspace_admin'];
    }

    function isWorkspaceInternal(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && workspaceRole(workspaceId) in ['superadmin', 'workspace_admin', 'project_lead', 'collaborator'];
    }

    function projectMemberPath(workspaceId, projectId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(projectId)/members/$(request.auth.uid);
    }

    function isDirectProjectMember(workspaceId, projectId) {
      return hasActiveProfile()
        && exists(projectMemberPath(workspaceId, projectId))
        && get(projectMemberPath(workspaceId, projectId)).data.status == 'active';
    }

    function projectRole(workspaceId, projectId) {
      return isWorkspaceAdmin(workspaceId)
        ? workspaceRole(workspaceId)
        : get(projectMemberPath(workspaceId, projectId)).data.role;
    }

    function canReadProject(workspaceId, projectId) {
      return isWorkspaceAdmin(workspaceId) || isDirectProjectMember(workspaceId, projectId);
    }

    function isInternalProjectUser(workspaceId, projectId) {
      return canReadProject(workspaceId, projectId)
        && projectRole(workspaceId, projectId) in ['superadmin', 'workspace_admin', 'project_lead', 'collaborator'];
    }

    function canLeadProject(workspaceId, projectId) {
      return canReadProject(workspaceId, projectId)
        && projectRole(workspaceId, projectId) in ['superadmin', 'workspace_admin', 'project_lead'];
    }

    function canReadCanvas(workspaceId, projectId) {
      return isInternalProjectUser(workspaceId, projectId);
    }

    function canEditCanvas(workspaceId, projectId) {
      return isInternalProjectUser(workspaceId, projectId);
    }

    function canManageCanvas(workspaceId, projectId) {
      return canLeadProject(workspaceId, projectId);
    }

    function validCanvas(workspaceId, projectId, canvasId) {
      return request.resource.data.id == canvasId
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.projectId == projectId
        && request.resource.data.templateId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.status in ['active', 'archived']
        && request.resource.data.createdBy is string
        && request.resource.data.createdByUid is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy is string
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.noteCount is int
        && request.resource.data.noteCount >= 0
        && request.resource.data.activeSectionCount is int
        && request.resource.data.activeSectionCount >= 0
        && request.resource.data.historyCount is int
        && request.resource.data.historyCount >= 0
        && request.resource.data.versionCount is int
        && request.resource.data.versionCount >= 0
        && request.resource.data.shareCount is int
        && request.resource.data.shareCount >= 0
        && request.resource.data.schemaVersion is int;
    }

    function validCanvasNote(workspaceId, projectId, canvasId, noteId) {
      return request.resource.data.id == noteId
        && request.resource.data.canvasId == canvasId
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.projectId == projectId
        && request.resource.data.sectionId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1200
        && request.resource.data.colorId is string
        && request.resource.data.colorHex is string
        && request.resource.data.authorId is string
        && request.resource.data.authorUid is string
        && request.resource.data.authorName is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && (request.resource.data.position is int || request.resource.data.position is float)
        && request.resource.data.commentCount is int
        && request.resource.data.commentCount >= 0
        && request.resource.data.sourceCanvasId is string
        && request.resource.data.sourceNoteId is string
        && request.resource.data.archived is bool
        && request.resource.data.archivedAt is string
        && request.resource.data.archivedBy is string
        && request.resource.data.schemaVersion is int;
    }

    function validCanvasComment(canvasId, noteId, commentId) {
      return request.resource.data.id == commentId
        && request.resource.data.noteId == noteId
        && request.resource.data.canvasId == canvasId
        && request.resource.data.authorId is string
        && request.resource.data.authorUid is string
        && request.resource.data.authorName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 800
        && request.resource.data.createdAt is string
        && request.resource.data.schemaVersion is int;
    }

    function validCanvasHistory(workspaceId, projectId, canvasId, eventId) {
      return request.resource.data.id == eventId
        && request.resource.data.canvasId == canvasId
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.projectId == projectId
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.actorId is string
        && request.resource.data.actorUid is string
        && request.resource.data.actorName is string
        && request.resource.data.createdAt is string
        && request.resource.data.meta is map
        && request.resource.data.schemaVersion is int;
    }

    function validCanvasVersion(workspaceId, projectId, canvasId, versionId) {
      return request.resource.data.id == versionId
        && request.resource.data.canvasId == canvasId
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.projectId == projectId
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.label is string
        && request.resource.data.createdAt is string
        && request.resource.data.createdBy is string
        && request.resource.data.createdByUid is string
        && request.resource.data.createdByName is string
        && request.resource.data.title is string
        && request.resource.data.templateId is string
        && request.resource.data.notes is list
        && request.resource.data.schemaVersion is int;
    }

    function validCanvasShareLink(workspaceId, projectId, canvasId, shareId) {
      return request.resource.data.id == shareId
        && request.resource.data.canvasId == canvasId
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.projectId == projectId
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 16
        && request.resource.data.label is string
        && request.resource.data.createdBy is string
        && request.resource.data.createdByUid is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdAt is string
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.active is bool
        && request.resource.data.schemaVersion is int;
    }

    function validPublicCanvasShare(shareId) {
      return request.resource.data.id == shareId
        && request.resource.data.code == shareId
        && request.resource.data.workspaceId is string
        && request.resource.data.projectId is string
        && request.resource.data.canvasId is string
        && request.resource.data.title is string
        && request.resource.data.templateId is string
        && request.resource.data.version is int
        && request.resource.data.noteCount is int
        && request.resource.data.activeSectionCount is int
        && request.resource.data.notes is list
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.active is bool
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.schemaVersion is int;
    }

    function canCreatePublicCanvasShare(shareId) {
      return signedIn()
        && validPublicCanvasShare(shareId)
        && canManageCanvas(request.resource.data.workspaceId, request.resource.data.projectId);
    }

    function canUpdatePublicCanvasShare(shareId) {
      return signedIn()
        && validPublicCanvasShare(shareId)
        && resource.data.workspaceId == request.resource.data.workspaceId
        && resource.data.projectId == request.resource.data.projectId
        && resource.data.canvasId == request.resource.data.canvasId
        && (
          canManageCanvas(resource.data.workspaceId, resource.data.projectId)
          || (
            canEditCanvas(resource.data.workspaceId, resource.data.projectId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'templateId', 'version', 'noteCount', 'activeSectionCount',
              'notes', 'updatedAt', 'schemaVersion'
            ])
          )
        );
    }


    function canReadKanban(workspaceId, projectId) {
      return canReadProject(workspaceId, projectId)
        && projectRole(workspaceId, projectId) in ['superadmin', 'workspace_admin', 'project_lead', 'collaborator', 'reviewer'];
    }

    function canEditKanban(workspaceId, projectId) {
      return canReadProject(workspaceId, projectId)
        && projectRole(workspaceId, projectId) in ['superadmin', 'workspace_admin', 'project_lead', 'collaborator'];
    }

    function validKanbanBoard(workspaceId, projectId, boardId) {
      return boardId == 'main'
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.projectId == projectId
        && request.resource.data.name is string
        && request.resource.data.columns is list
        && request.resource.data.schemaVersion is int;
    }

    function validKanbanCard(workspaceId, projectId, cardId) {
      return request.resource.data.id == cardId
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.projectId == projectId
        && request.resource.data.title is string
        && request.resource.data.columnId is string
        && (request.resource.data.position is int || request.resource.data.position is float)
        && request.resource.data.archived is bool
        && request.resource.data.schemaVersion is int;
    }

    function canReadDeliverables(workspaceId, projectId) {
      return canReadProject(workspaceId, projectId)
        && projectRole(workspaceId, projectId) in ['superadmin', 'workspace_admin', 'project_lead', 'collaborator', 'reviewer', 'client', 'guest'];
    }

    function canManageDeliverables(workspaceId, projectId) {
      return canReadProject(workspaceId, projectId)
        && projectRole(workspaceId, projectId) in ['superadmin', 'workspace_admin', 'project_lead', 'collaborator'];
    }

    function canReviewDeliverables(workspaceId, projectId) {
      return canReadProject(workspaceId, projectId)
        && projectRole(workspaceId, projectId) in ['superadmin', 'workspace_admin', 'client'];
    }

    function canCommentDeliverables(workspaceId, projectId) {
      return canReadProject(workspaceId, projectId)
        && projectRole(workspaceId, projectId) != 'guest';
    }

    function validDeliverable(workspaceId, projectId, deliverableId) {
      return request.resource.data.id == deliverableId
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.projectId == projectId
        && request.resource.data.title is string
        && request.resource.data.status in ['draft', 'in_review', 'changes_requested', 'approved']
        && request.resource.data.visibility in ['internal', 'client']
        && request.resource.data.archived is bool
        && request.resource.data.checklist is list
        && request.resource.data.versions is list
        && request.resource.data.comments is list
        && request.resource.data.history is list
        && request.resource.data.schemaVersion is int;
    }

    function validWorkspaceDocument(workspaceId) {
      return request.resource.data.id == workspaceId
        && request.resource.data.name is string
        && request.resource.data.status in ['active', 'inactive', 'archived'];
    }

    function validProjectDocument(workspaceId, projectId) {
      return request.resource.data.id == projectId
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.name is string
        && request.resource.data.status in ['draft', 'planned', 'active', 'pending_client', 'on_hold', 'blocked', 'completed', 'archived'];
    }

    function validMembership(workspaceId) {
      return request.resource.data.workspaceId == workspaceId
        && request.resource.data.authUid is string
        && request.resource.data.role in ['superadmin', 'workspace_admin', 'project_lead', 'collaborator', 'reviewer', 'client', 'guest']
        && request.resource.data.status in ['active', 'inactive', 'pending'];
    }

    match /users/{userId} {
      allow read: if hasActiveProfile() && (request.auth.uid == userId || isSuperadmin());
      allow create, delete: if isSuperadmin();
      allow update: if isSuperadmin() || (
        hasActiveProfile()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'initials', 'photoURL', 'lastSeenAt', 'updatedAt'
        ])
      );

      match /projectAssignments/{projectId} {
        allow read: if hasActiveProfile() && request.auth.uid == userId;
        allow create, update: if isSuperadmin() || (
          hasActiveProfile()
          && request.resource.data.id == projectId
          && request.resource.data.projectId == projectId
          && request.resource.data.workspaceId is string
          && request.resource.data.authUid == userId
          && request.resource.data.role in ['project_lead', 'collaborator', 'reviewer', 'client', 'guest']
          && request.resource.data.status in ['active', 'inactive', 'pending']
          && canLeadProject(request.resource.data.workspaceId, projectId)
        );
        allow delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if hasActiveProfile() && request.auth.uid == userId;
        allow create: if hasActiveProfile()
          && request.resource.data.id == notificationId
          && request.resource.data.recipientUid == userId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.workspaceId is string
          && request.resource.data.projectId is string
          && canReadProject(request.resource.data.workspaceId, request.resource.data.projectId);
        allow update: if hasActiveProfile()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow delete: if false;
      }
    }

    match /system/{documentId} {
      allow read, write: if isSuperadmin();

      match /migrations/{migrationId} {
        allow read, write: if isSuperadmin();
      }

      match /userActivations/{activationId} {
        allow read, write: if isSuperadmin();
      }

      match /userAdminAudit/{auditId} {
        allow read: if isSuperadmin();
        allow write: if false;
      }
    }

    match /canvasShares/{shareId} {
      allow get: if resource.data.active == true
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time;
      allow list: if false;
      allow create: if canCreatePublicCanvasShare(shareId);
      allow update: if canUpdatePublicCanvasShare(shareId);
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);
      allow create: if isSuperadmin() && validWorkspaceDocument(workspaceId);
      allow update: if isWorkspaceAdmin(workspaceId) && validWorkspaceDocument(workspaceId);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isWorkspaceAdmin(workspaceId) || (signedIn() && request.auth.uid == memberId);
        allow create, update: if isWorkspaceAdmin(workspaceId)
          && validMembership(workspaceId)
          && (request.resource.data.role != 'superadmin' || isSuperadmin());
        allow delete: if false;
      }

      match /people/{personId} {
        allow read: if isWorkspaceInternal(workspaceId)
          || (isWorkspaceMember(workspaceId) && workspaceRole(workspaceId) == 'reviewer');
        allow create, update: if isWorkspaceMember(workspaceId)
          && workspaceRole(workspaceId) in ['superadmin', 'workspace_admin', 'project_lead']
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.id == personId;
        allow delete: if false;
      }

      match /clients/{clientId} {
        allow read: if isWorkspaceInternal(workspaceId);
        allow create, update: if isWorkspaceAdmin(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.id == clientId;
        allow delete: if false;
      }

      match /projects/{projectId} {
        allow read: if canReadProject(workspaceId, projectId);
        allow create: if isWorkspaceAdmin(workspaceId) && validProjectDocument(workspaceId, projectId);
        allow update: if canLeadProject(workspaceId, projectId) && validProjectDocument(workspaceId, projectId);
        allow delete: if false;

        match /members/{memberId} {
          allow read: if canReadKanban(workspaceId, projectId)
            || (signedIn() && request.auth.uid == memberId);
          allow create, update: if canLeadProject(workspaceId, projectId)
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.projectId == projectId
            && request.resource.data.role in ['project_lead', 'collaborator', 'reviewer', 'client', 'guest']
            && request.resource.data.status in ['active', 'inactive', 'pending'];
          allow delete: if false;
        }

        match /resources/{resourceId} {
          allow read: if isInternalProjectUser(workspaceId, projectId)
            || (canReadProject(workspaceId, projectId) && resource.data.visibility == 'client');
          allow create, update: if isInternalProjectUser(workspaceId, projectId)
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.projectId == projectId;
          allow delete: if false;
        }

        match /milestones/{milestoneId} {
          allow read: if isInternalProjectUser(workspaceId, projectId)
            || (canReadProject(workspaceId, projectId) && resource.data.visibility == 'client');
          allow create, update: if canLeadProject(workspaceId, projectId)
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.projectId == projectId;
          allow delete: if false;
        }

        match /boards/{boardId} {
          allow read: if canReadKanban(workspaceId, projectId);
          allow create, update: if canEditKanban(workspaceId, projectId)
            && validKanbanBoard(workspaceId, projectId, boardId);
          allow delete: if false;

          match /cards/{cardId} {
            allow read: if canReadKanban(workspaceId, projectId);
            allow create: if canEditKanban(workspaceId, projectId)
              && validKanbanCard(workspaceId, projectId, cardId);
            allow update: if validKanbanCard(workspaceId, projectId, cardId) && (
              canEditKanban(workspaceId, projectId)
              || (
                canReadKanban(workspaceId, projectId)
                && projectRole(workspaceId, projectId) == 'reviewer'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'comments', 'history', 'updatedAt', 'updatedBy'
                ])
              )
            );
            allow delete: if isWorkspaceAdmin(workspaceId);
          }
        }

        match /activity/{eventId} {
          allow read: if canReadKanban(workspaceId, projectId);
          allow create: if canReadKanban(workspaceId, projectId)
            && request.resource.data.id == eventId
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.projectId == projectId
            && request.resource.data.actorUid == request.auth.uid;
          allow update, delete: if false;
        }

        match /canvases/{canvasId} {
          allow read: if canReadCanvas(workspaceId, projectId);
          allow create: if canEditCanvas(workspaceId, projectId)
            && validCanvas(workspaceId, projectId, canvasId);
          allow update: if validCanvas(workspaceId, projectId, canvasId) && (
            canManageCanvas(workspaceId, projectId)
            || (
              canEditCanvas(workspaceId, projectId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'version', 'noteCount', 'activeSectionCount', 'historyCount',
                'versionCount', 'shareCount', 'updatedAt', 'updatedBy', 'schemaVersion'
              ])
            )
          );
          allow delete: if false;

          match /notes/{noteId} {
            allow read: if canReadCanvas(workspaceId, projectId);
            allow create, update: if canEditCanvas(workspaceId, projectId)
              && validCanvasNote(workspaceId, projectId, canvasId, noteId);
            allow delete: if false;

            match /comments/{commentId} {
              allow read: if canReadCanvas(workspaceId, projectId);
              allow create: if canEditCanvas(workspaceId, projectId)
                && validCanvasComment(canvasId, noteId, commentId)
                && (isSuperadmin() || request.resource.data.authorUid == request.auth.uid);
              allow update, delete: if false;
            }
          }

          match /history/{eventId} {
            allow read: if canReadCanvas(workspaceId, projectId);
            allow create: if canEditCanvas(workspaceId, projectId)
              && validCanvasHistory(workspaceId, projectId, canvasId, eventId)
              && (isSuperadmin() || request.resource.data.actorUid == request.auth.uid);
            allow update, delete: if false;
          }

          match /versions/{versionId} {
            allow read: if canReadCanvas(workspaceId, projectId);
            allow create: if validCanvasVersion(workspaceId, projectId, canvasId, versionId)
              && (isSuperadmin() || request.resource.data.createdByUid == request.auth.uid)
              && (
                canManageCanvas(workspaceId, projectId)
                || (
                  canEditCanvas(workspaceId, projectId)
                  && versionId == 'version-initial-' + canvasId
                )
              );
            allow update, delete: if false;
          }

          match /shareLinks/{shareId} {
            allow read: if canManageCanvas(workspaceId, projectId);
            allow create, update: if canManageCanvas(workspaceId, projectId)
              && validCanvasShareLink(workspaceId, projectId, canvasId, shareId);
            allow delete: if false;
          }
        }

        match /deliverables/{deliverableId} {
          // Internal project members can read every deliverable. Reviewer, client and guest
          // roles can only read records explicitly published for the client portal.
          allow read: if isInternalProjectUser(workspaceId, projectId)
            || (
              canReadProject(workspaceId, projectId)
              && projectRole(workspaceId, projectId) in ['reviewer', 'client', 'guest']
              && resource.data.visibility == 'client'
            );
          allow create: if isInternalProjectUser(workspaceId, projectId)
            && validDeliverable(workspaceId, projectId, deliverableId);
          allow update: if validDeliverable(workspaceId, projectId, deliverableId) && (
            isInternalProjectUser(workspaceId, projectId)
            || (
              canReviewDeliverables(workspaceId, projectId)
              && resource.data.visibility == 'client'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'approvedAt', 'approvedBy', 'changeRequestedAt',
                'comments', 'history', 'updatedAt', 'updatedBy', 'schemaVersion'
              ])
            )
            || (
              canCommentDeliverables(workspaceId, projectId)
              && resource.data.visibility == 'client'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'comments', 'history', 'updatedAt', 'updatedBy', 'schemaVersion'
              ])
            )
          );
          allow delete: if false;

          match /comments/{commentId} {
            allow read: if canReadDeliverables(workspaceId, projectId);
            allow create: if canCommentDeliverables(workspaceId, projectId);
            allow update: if canManageDeliverables(workspaceId, projectId)
              || (signedIn() && resource.data.authUid == request.auth.uid);
            allow delete: if false;
          }

          match /versions/{versionId} {
            allow read: if canReadDeliverables(workspaceId, projectId);
            allow create, update: if canManageDeliverables(workspaceId, projectId);
            allow delete: if false;
          }
        }

        match /finance/{financeId} {
          allow read: if isInternalProjectUser(workspaceId, projectId);
          allow create, update: if canLeadProject(workspaceId, projectId);
          allow delete: if false;

          match /incomes/{incomeId} {
            allow read: if isInternalProjectUser(workspaceId, projectId);
            allow create, update: if canLeadProject(workspaceId, projectId);
            allow delete: if false;
          }

          match /costs/{costId} {
            allow read: if isInternalProjectUser(workspaceId, projectId);
            allow create, update: if canLeadProject(workspaceId, projectId);
            allow delete: if false;
          }

          match /timeEntries/{entryId} {
            allow read: if isInternalProjectUser(workspaceId, projectId);
            allow create: if isInternalProjectUser(workspaceId, projectId);
            allow update: if canLeadProject(workspaceId, projectId)
              || (signedIn() && resource.data.authUid == request.auth.uid);
            allow delete: if false;
          }

          match /rates/{rateId} {
            allow read, create, update: if isWorkspaceAdmin(workspaceId);
            allow delete: if false;
          }
        }
      }
    }
  }
}
