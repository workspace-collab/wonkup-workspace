{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$workspaceId": {
        "$projectId": {
          "$canvasId": {
            ".read": "auth != null",
            "$uid": {
              "$connectionId": {
                ".write": "auth != null && auth.uid == $uid",
                ".validate": "!newData.exists() || newData.hasChildren(['authUid', 'userId', 'userName', 'initials', 'clientId', 'lastChanged'])",
                "authUid": {
                  ".validate": "newData.isString() && newData.val() == auth.uid"
                },
                "userId": {
                  ".validate": "newData.isString() && newData.val().length <= 160"
                },
                "userName": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160"
                },
                "initials": {
                  ".validate": "newData.isString() && newData.val().length <= 8"
                },
                "clientId": {
                  ".validate": "newData.isString() && newData.val() == $connectionId"
                },
                "lastChanged": {
                  ".validate": "newData.isNumber() && newData.val() <= now + 10000"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        }
      }
    }
  }
}
